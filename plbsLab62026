    // ============================================================

    let rawData = [];
    let historyLog = []; 
    const dt = 1.0;
    
    let isUserZoomed = false;
    let currentStepIndex = 0; 
    
    const DEFAULT_SIGMA_OBS = 25;
    const DEFAULT_SIGMA_MODEL = 1.0;

    window.onload = function() {
        parseDataString(rawDataInput);
    };

    function parseDataString(text) {
        rawData = [];
        const lines = text.trim().split('\n');
        lines.forEach(line => {
            line = line.trim();
            if(!line || line.startsWith('PASTE') || line.startsWith('(Format')) return; 
            const parts = line.split(/\s+/);
            if (parts.length >= 3) {
                const x = parseFloat(parts[1]);
                const y = parseFloat(parts[2]);
                if (!isNaN(x) && !isNaN(y)) rawData.push([x, y]);
            }
        });

        if (rawData.length > 0) {
            runKalman();
            setupInteractions();
        }
    }

    function setupInteractions() {
        const plotDiv = document.getElementById('plotDiv');
        
        plotDiv.on('plotly_relayout', function(eventdata){
            if (eventdata['xaxis.range[0]'] || eventdata['xaxis.range']) isUserZoomed = true;
            if (eventdata['xaxis.autorange'] === true) isUserZoomed = false;
        });

        plotDiv.on('plotly_hover', function(data){
            const pointIndex = data.points[0].pointNumber;
            currentStepIndex = pointIndex; 
            refreshPanel(); 
        });
    }

    function resetParams() {
        const sliderObs = document.getElementById('sigmaObs');
        const sliderModel = document.getElementById('sigmaModel');
        sliderObs.value = DEFAULT_SIGMA_OBS;
        sliderModel.value = DEFAULT_SIGMA_MODEL;
        document.getElementById('valObs').innerText = DEFAULT_SIGMA_OBS;
        document.getElementById('valModel').innerText = DEFAULT_SIGMA_MODEL;
        if (rawData.length > 0) { runKalman(); refreshPanel(); }
    }

    function updateAll(val, type) {
        if(type) document.getElementById('val' + type).innerText = val;
        if (rawData.length > 0) { runKalman(); refreshPanel(); }
    }

    function resetZoom() {
        const plotDiv = document.getElementById('plotDiv');
        isUserZoomed = false;
        Plotly.relayout(plotDiv, { 'xaxis.autorange': true, 'yaxis.autorange': true });
    }

    function runKalman() {
        const sigma_obs = parseFloat(document.getElementById('sigmaObs').value);
        const sigma_model = parseFloat(document.getElementById('sigmaModel').value);

        // Initial State
        let x = math.matrix([[rawData[0][0]], [rawData[0][1]], [0], [0]]); 
        
        const T = math.matrix([[1, 0, dt, 0], [0, 1, 0, dt], [0, 0, 1, 0], [0, 0, 0, 1]]);
        const A = math.matrix([[1, 0, 0, 0], [0, 1, 0, 0]]); 
        
        const sm2 = sigma_model * sigma_model;
        const Q = math.diag([sm2, sm2, sm2, sm2]); // C_model
        
        const so2 = sigma_obs * sigma_obs;
        const R = math.diag([so2, so2]); // C_obs
        
        let P = math.diag([100, 100, 1, 1]); // P (Covariance)

        let kX = [], kY = [];
        historyLog = []; 

        for (let i = 0; i < rawData.length; i++) {
            let z = math.matrix([[rawData[i][0]], [rawData[i][1]]]); 

            // Predict
            let x_pred = math.multiply(T, x);
            let P_pred = math.add(math.multiply(math.multiply(T, P), math.transpose(T)), Q);
            
            let P_prior_val = P_pred.get([0,0]); 
            let X_est_val = x_pred.get([0,0]);

            // Update
            let S = math.add(math.multiply(math.multiply(A, P_pred), math.transpose(A)), R);
            let S_inv;
            try { S_inv = math.inv(S); } catch(e) { S_inv = math.identity(2); }
            
            let K = math.multiply(math.multiply(P_pred, math.transpose(A)), S_inv);
            
            let innovation = math.subtract(z, math.multiply(A, x_pred));
            x = math.add(x_pred, math.multiply(K, innovation));
            
            let I = math.identity(4);
            P = math.multiply(math.subtract(I, math.multiply(K, A)), P_pred);

            kX.push(x.get([0, 0]));
            kY.push(x.get([1, 0]));

            historyLog.push({
                t: i + 1,
                k: K.get([0, 0]), 
                x_est: X_est_val,
                p_est: P_prior_val,
                z: rawData[i][0],
                x_new: x.get([0, 0]),
                p_new: P.get([0, 0])
            });
        }

        drawPlot(kX, kY);
    }

    function drawPlot(kX, kY) {
        const plotDiv = document.getElementById('plotDiv');
        const traceObs = {
            x: rawData.map(p => p[0]), y: rawData.map(p => p[1]),
            mode: 'markers', name: 'Sensor (Obs)',
            marker: { color: '#718096', size: 6, opacity: 0.5, line: {color: 'white', width: 0.5} } 
        };
        const traceKalman = {
            x: kX, y: kY, mode: 'lines', name: 'Kalman (Est)',
            line: { color: '#e53e3e', width: 3 } 
        };
        const baseLayout = {
            autosize: true, margin: { l: 50, r: 20, t: 30, b: 40 },
            xaxis: { title: 'X Position (m)', zeroline: false, showgrid: true, gridcolor: '#edf2f7' },
            yaxis: { title: 'Y Position (m)', zeroline: false, showgrid: true, gridcolor: '#edf2f7' },
            legend: { x: 0, y: 1, bgcolor: 'rgba(255,255,255,0.9)' },
            hovermode: 'closest', paper_bgcolor: '#f8f9fa', plot_bgcolor: '#ffffff'
        };
        const finalLayout = Object.assign({}, baseLayout);
        if (isUserZoomed && plotDiv.layout) {
            if(plotDiv.layout.xaxis && plotDiv.layout.xaxis.range) finalLayout.xaxis.range = plotDiv.layout.xaxis.range;
            if(plotDiv.layout.yaxis && plotDiv.layout.yaxis.range) finalLayout.yaxis.range = plotDiv.layout.yaxis.range;
        }
        Plotly.react('plotDiv', [traceObs, traceKalman], finalLayout, {responsive: true});
    }

    function refreshPanel() {
        if (!historyLog[currentStepIndex]) return;
        const d = historyLog[currentStepIndex];
        document.getElementById('disp-t').innerText = d.t;
        document.getElementById('disp-k').innerText = d.k.toFixed(4);
        document.getElementById('disp-x-est').innerText = d.x_est.toFixed(2);
        document.getElementById('disp-z').innerText = d.z.toFixed(2);
        document.getElementById('disp-x-new').innerText = d.x_new.toFixed(2);
        document.getElementById('disp-p-est').innerText = d.p_est.toFixed(2);
        document.getElementById('disp-p-new').innerText = d.p_new.toFixed(2);
    }
